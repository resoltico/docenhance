{
  "type": "object",
  "required": [
    "record",
    "build",
    "source",
    "request",
    "execution",
    "protection",
    "output"
  ],
  "additionalProperties": false,
  "properties": {
    "record": {
      "type": "object",
      "required": [
        "version",
        "run",
        "recorded"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "run": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "recorded": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "application_version",
        "platform",
        "compiler",
        "dependency_lock_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "application_version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "dependency_lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "sha256",
        "bytes",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000/]+$"
        }
      }
    },
    "request": {
      "type": "object",
      "required": [
        "operation",
        "protection_supplied"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "type": "object",
          "required": [
            "kind",
            "method",
            "parameters"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "binarization",
                "continuous"
              ]
            },
            "method": {},
            "parameters": {}
          },
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "continuous"
                },
                "method": {
                  "type": "null"
                },
                "parameters": {
                  "type": "object",
                  "required": [
                    "output_mode",
                    "depth",
                    "alpha",
                    "profile"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "output_mode": {
                      "enum": [
                        "gray",
                        "preserve"
                      ]
                    },
                    "depth": {
                      "enum": [
                        "automatic",
                        "8",
                        "16"
                      ]
                    },
                    "alpha": {
                      "enum": [
                        "black",
                        "white",
                        "reject"
                      ]
                    },
                    "profile": {
                      "enum": [
                        "embedded",
                        "srgb"
                      ]
                    }
                  }
                }
              }
            },
            {
              "properties": {
                "kind": {
                  "const": "binarization"
                },
                "method": {
                  "$ref": "#/$defs/binary_method"
                },
                "parameters": {}
              },
              "oneOf": [
                {
                  "properties": {
                    "method": {
                      "properties": {
                        "id": {
                          "const": "B02"
                        }
                      }
                    },
                    "parameters": {
                      "type": "object",
                      "required": [
                        "window",
                        "k",
                        "r"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "window": {
                          "type": "integer",
                          "minimum": 3,
                          "maximum": 4095,
                          "not": {
                            "multipleOf": 2
                          }
                        },
                        "k": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "r": {
                          "type": "number",
                          "minimum": 0.00392156862745098,
                          "maximum": 1
                        }
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "method": {
                      "properties": {
                        "id": {
                          "const": "B03"
                        }
                      }
                    },
                    "parameters": {
                      "type": "object",
                      "required": [
                        "threshold"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "threshold": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "protection_supplied": {
          "type": "boolean"
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "conversion",
        "illumination"
      ],
      "additionalProperties": false,
      "properties": {
        "conversion": {
          "anyOf": [
            {
              "$ref": "#/$defs/conversion"
            },
            {
              "type": "null"
            }
          ]
        },
        "illumination": {
          "$ref": "#/$defs/illumination"
        }
      }
    },
    "protection": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "supplied",
            "stored",
            "width",
            "height",
            "polarity",
            "frame"
          ],
          "additionalProperties": false,
          "properties": {
            "supplied": {
              "type": "object",
              "required": [
                "sha256",
                "bytes"
              ],
              "additionalProperties": false,
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 18446744073709551615
                }
              }
            },
            "stored": {
              "type": "object",
              "required": [
                "path",
                "sha256",
                "bytes"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "const": "assets/protect-mask.png"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 268435456
                }
              }
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "polarity": {
              "const": "white_protects"
            },
            "frame": {
              "const": "oriented_source"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "output": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes",
        "width",
        "height",
        "channels",
        "bit_depth",
        "profile_embedded",
        "resolution",
        "verification"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "result.png"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "channels": {
          "enum": [
            1,
            3
          ]
        },
        "bit_depth": {
          "enum": [
            8,
            16
          ]
        },
        "profile_embedded": {
          "type": "boolean"
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        },
        "verification": {
          "type": "object",
          "required": [
            "performed",
            "compared"
          ],
          "additionalProperties": false,
          "properties": {
            "performed": {
              "const": "decoded_and_compared"
            },
            "compared": {
              "const": [
                "integer_samples",
                "metadata"
              ]
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docenhance.invalid/schemas/run-record.schema.json",
  "$defs": {
    "binary_method": {},
    "conversion": {},
    "resolution": {},
    "illumination": {},
    "illumination_method": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "request": {
            "properties": {
              "protection_supplied": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "protection": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "protection": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request": {
            "properties": {
              "operation": {
                "properties": {
                  "kind": {
                    "const": "binarization"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "protection": {
            "type": "null"
          },
          "execution": {
            "properties": {
              "conversion": {
                "type": "null"
              },
              "illumination": {
                "properties": {
                  "status": {
                    "const": "disabled"
                  },
                  "requested": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "output": {
            "properties": {
              "channels": {
                "const": 1
              },
              "bit_depth": {
                "const": 8
              },
              "profile_embedded": {
                "const": false
              },
              "resolution": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "execution": {
            "properties": {
              "conversion": {
                "type": "object"
              }
            }
          },
          "output": {
            "properties": {
              "profile_embedded": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
