{
  "$comment": "The reviewed source of the layer graph, target identities and boundary permissions. CMake enforces declared links; tools/check_architecture.py checks includes, AST restrictions and the matching documentation table. may_allocate permits explicit allocation expressions and allocator calls only in the owning layer. This is not a ban on implicit standard-library metadata allocation or a process-RSS guarantee. A shared restriction baseline admits only explicit layer exceptions. Private production headers are owner-only; registered clients may reach their root closure but no private production header.",
  "restrictions": {
    "headers": [
      "condition_variable",
      "execution",
      "filesystem",
      "fstream",
      "future",
      "iostream",
      "latch",
      "semaphore",
      "stop_token",
      "thread"
    ],
    "calls": [
      "aligned_alloc",
      "calloc",
      "exit",
      "fopen",
      "free",
      "getenv",
      "imread",
      "imwrite",
      "malloc",
      "popen",
      "posix_memalign",
      "realloc",
      "secure_getenv",
      "strdup",
      "system"
    ],
    "thread_types": [
      "::std::thread",
      "::std::jthread"
    ],
    "thread_calls": [
      "::std::async",
      "pthread_create",
      "thrd_create",
      "CreateThread",
      "CreateRemoteThread",
      "_beginthread",
      "_beginthreadex"
    ]
  },
  "clients": {
    "fuzz/cli.cpp": "cli"
  },
  "packages": {
    "CLI11": {
      "targets": [
        "CLI11::CLI11"
      ],
      "headers": [
        "CLI/"
      ]
    },
    "nlohmann_json": {
      "targets": [
        "nlohmann_json::nlohmann_json"
      ],
      "headers": [
        "nlohmann/"
      ]
    },
    "opencv": {
      "targets": [
        "opencv_core",
        "opencv_flann",
        "opencv_geometry",
        "opencv_imgproc",
        "opencv_photo"
      ],
      "headers": [
        "opencv2/"
      ]
    },
    "leptonica": {
      "targets": [
        "DE::leptonica"
      ],
      "headers": [
        "leptonica/",
        "allheaders.h"
      ]
    },
    "lcms": {
      "targets": [
        "DE::lcms"
      ],
      "headers": [
        "lcms2.h",
        "lcms2_plugin.h"
      ]
    },
    "jpeg": {
      "targets": [
        "DE::jpeg"
      ],
      "headers": [
        "jpeglib.h",
        "jerror.h",
        "jconfig.h",
        "jmorecfg.h"
      ]
    },
    "png": {
      "targets": [
        "DE::png"
      ],
      "headers": [
        "png.h",
        "pngconf.h",
        "pnglibconf.h"
      ]
    },
    "tiff": {
      "targets": [
        "DE::tiff"
      ],
      "headers": [
        "tiffio.h",
        "docenhance_tiff.h",
        "tiff.h",
        "tiffconf.h",
        "tiffvers.h"
      ]
    },
    "picosha2": {
      "targets": [
        "DE::picosha2"
      ],
      "headers": [
        "picosha2.h"
      ]
    },
    "catch2": {
      "targets": [
        "Catch2::Catch2WithMain",
        "Catch2::Catch2"
      ],
      "headers": [
        "catch2/"
      ]
    },
    "zlib": {
      "targets": [
        "DE::zlib"
      ],
      "headers": [
        "zlib.h",
        "zconf.h"
      ]
    }
  },
  "layers": {
    "core": {
      "target": "de_core",
      "summary": "Errors, owned allocation budgets and the Result vocabulary",
      "uses": [],
      "external": [],
      "may_allocate": true,
      "allow_headers": [
        "stop_token"
      ]
    },
    "contract": {
      "target": "de_contract",
      "summary": "The command vocabulary, generated option descriptors and strict value parsers",
      "uses": [
        "core"
      ],
      "external": []
    },
    "exec": {
      "target": "de_exec",
      "summary": "The schedule: how many workers run a page's independent work items",
      "uses": [
        "core"
      ],
      "external": [],
      "may_thread": true,
      "may_catch": true,
      "allow_headers": [
        "condition_variable",
        "execution",
        "future",
        "latch",
        "semaphore",
        "stop_token",
        "thread"
      ]
    },
    "image": {
      "target": "de_image",
      "summary": "Checked owning planes, borrowed views and numerical primitives",
      "uses": [
        "core"
      ],
      "external": []
    },
    "methods": {
      "target": "de_methods",
      "summary": "Pure image operations and typed executable method catalog",
      "uses": [
        "core",
        "exec",
        "image"
      ],
      "external": []
    },
    "io": {
      "target": "de_io",
      "summary": "PNG/JPEG/TIFF codecs, metadata, hashing and exclusive publication",
      "uses": [
        "core",
        "image"
      ],
      "external": [
        "picosha2",
        "png",
        "zlib",
        "jpeg",
        "tiff"
      ],
      "may_catch": true,
      "allow_headers": [
        "filesystem",
        "fstream"
      ],
      "allow_calls": [
        "fopen"
      ]
    },
    "bundle": {
      "target": "de_bundle",
      "summary": "The persistent run record: one written form for the facts an execution produced",
      "uses": [
        "core",
        "image",
        "methods"
      ],
      "external": [
        "nlohmann_json"
      ],
      "interface_packages": [
        "nlohmann_json"
      ],
      "may_catch": true
    },
    "app": {
      "target": "de_app",
      "summary": "Validated use cases and the explicit processing and verification ports",
      "uses": [
        "contract",
        "core",
        "image",
        "methods"
      ],
      "external": [],
      "may_catch": true
    },
    "report": {
      "target": "de_report",
      "summary": "Renders an outcome as the documented JSON response or as human text",
      "uses": [
        "app",
        "bundle",
        "contract",
        "core",
        "image",
        "methods"
      ],
      "external": [
        "nlohmann_json"
      ]
    },
    "cli": {
      "target": "de_cli",
      "summary": "CLI11 syntax adapter, process streams and exit status",
      "uses": [
        "core",
        "contract",
        "app",
        "report"
      ],
      "external": [
        "CLI11"
      ],
      "may_catch": true,
      "allow_headers": [
        "iostream"
      ]
    },
    "host": {
      "target": "de_host",
      "summary": "Executes admitted requests using codecs, kernels and publication",
      "uses": [
        "app",
        "bundle",
        "color",
        "core",
        "exec",
        "image",
        "io",
        "methods",
        "opencv"
      ],
      "external": []
    },
    "entry": {
      "target": "docenhance",
      "summary": "The process entry point and sole production composition root",
      "uses": [
        "cli",
        "core",
        "host"
      ],
      "external": [],
      "may_catch": true,
      "public_headers": false,
      "allow_headers": [
        "iostream"
      ]
    },
    "color": {
      "target": "de_color",
      "summary": "Context-local color interpretation and bounded continuous-tone row conversion",
      "uses": [
        "core",
        "image"
      ],
      "external": [
        "lcms"
      ],
      "may_catch": true,
      "may_allocate": true
    },
    "opencv": {
      "target": "de_opencv",
      "summary": "Bounded CPU OpenCV NLM and Fourier restoration execution",
      "uses": [
        "core",
        "image",
        "methods"
      ],
      "external": [
        "opencv"
      ],
      "may_catch": true
    }
  }
}
