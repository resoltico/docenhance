{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "source_commit",
    "executable_sha256",
    "frozen_corpus_sha256",
    "panel",
    "corpus",
    "assessments"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "executable_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "frozen_corpus_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "panel": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "independent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "independent": {
            "const": true
          }
        }
      },
      "minItems": 3
    },
    "corpus": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "permission",
          "split",
          "classes",
          "document_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "permission": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "basis",
              "evidence",
              "curator"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "curator": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "split": {
            "enum": [
              "heldout",
              "tuning"
            ]
          },
          "classes": {
            "$ref": "#/$defs/classes"
          },
          "document_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample",
          "baseline",
          "candidate",
          "replicate",
          "reviews",
          "options",
          "baseline_options"
        ],
        "properties": {
          "sample": {
            "type": "string",
            "minLength": 1
          },
          "baseline": {
            "type": "string",
            "minLength": 1
          },
          "candidate": {
            "type": "string",
            "minLength": 1
          },
          "replicate": {
            "type": "string",
            "minLength": 1
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reviewer",
                "blind_pair",
                "delta",
                "harms",
                "uncertain",
                "rationale"
              ],
              "properties": {
                "reviewer": {
                  "type": "string",
                  "minLength": 1
                },
                "blind_pair": {
                  "type": "string",
                  "minLength": 1
                },
                "delta": {
                  "type": "integer",
                  "minimum": -2,
                  "maximum": 2
                },
                "harms": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "lost_mark",
                      "clipped_glyph",
                      "false_contour",
                      "degraded_good_page",
                      "geometry",
                      "protection"
                    ]
                  },
                  "minItems": 0
                },
                "uncertain": {
                  "type": "boolean"
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "minItems": 3
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "baseline_options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          }
        }
      },
      "minItems": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline document quality evidence; clearance assertions require curator review",
  "$defs": {
    "classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "handwriting",
          "print",
          "mixed_marks",
          "aged",
          "alpha",
          "color_text",
          "stains",
          "bleed_through",
          "skew",
          "oversharpened",
          "already_good",
          "faint_marks",
          "preservation_control"
        ]
      }
    }
  }
}
