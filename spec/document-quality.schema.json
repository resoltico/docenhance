{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen offline quality evaluation plan and factual report v2",
  "oneOf": [
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/report"
    }
  ],
  "$defs": {
    "classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "handwriting",
          "print",
          "mixed_marks",
          "aged",
          "alpha",
          "color_text",
          "stains",
          "bleed_through",
          "skew",
          "oversharpened",
          "already_good",
          "faint_marks",
          "preservation_control"
        ]
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "protocol",
        "protocol_sha256",
        "preregistration",
        "assessments"
      ],
      "properties": {
        "protocol_version": {
          "const": 2
        },
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_commit",
            "executable_sha256",
            "frozen_corpus_sha256",
            "panel",
            "corpus",
            "pages",
            "build_provenance",
            "review_protocol",
            "assignment",
            "tuning",
            "claim_policy"
          ],
          "properties": {
            "source_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "executable_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "frozen_corpus_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "panel": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "independent"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "independent": {
                    "const": true
                  }
                }
              },
              "minItems": 3
            },
            "corpus": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sample"
              },
              "minItems": 1
            },
            "pages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sample",
                  "blind_pair",
                  "commands",
                  "assets"
                ],
                "properties": {
                  "sample": {
                    "type": "string",
                    "minLength": 1
                  },
                  "blind_pair": {
                    "type": "string",
                    "minLength": 1
                  },
                  "commands": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "candidate",
                      "baseline",
                      "replicate"
                    ],
                    "properties": {
                      "candidate": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 6
                      },
                      "baseline": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 6
                      },
                      "replicate": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 6
                      }
                    }
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "sha256"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    },
                    "uniqueItems": true
                  }
                }
              }
            },
            "build_provenance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "review_protocol": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "assignment": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "tuning": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "performed",
                "receipt"
              ],
              "properties": {
                "performed": {
                  "type": "boolean"
                },
                "receipt": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "sha256"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "claim_policy": {
              "const": {
                "classes": [
                  "handwriting",
                  "print",
                  "mixed_marks",
                  "aged",
                  "alpha",
                  "color_text",
                  "stains",
                  "bleed_through",
                  "skew",
                  "oversharpened",
                  "already_good",
                  "faint_marks",
                  "preservation_control"
                ],
                "family_error_rate": 0.05,
                "controls": [
                  "already_good",
                  "preservation_control"
                ],
                "control_minimum_pages": 2,
                "benefit": "unanimous_positive_certain",
                "ties": "nonpositive"
              }
            }
          }
        },
        "protocol_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "preregistration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "assessments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sample",
              "candidate",
              "baseline",
              "replicate",
              "reviews",
              "review_revisions"
            ],
            "properties": {
              "sample": {
                "type": "string",
                "minLength": 1
              },
              "candidate": {
                "$ref": "#/$defs/role"
              },
              "baseline": {
                "$ref": "#/$defs/role"
              },
              "replicate": {
                "$ref": "#/$defs/role"
              },
              "reviews": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/review"
                }
              },
              "review_revisions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "scope",
        "source_commit",
        "protocol_sha256",
        "frozen_corpus_sha256",
        "executable_sha256",
        "classes",
        "decision",
        "clearance",
        "build_commit_binding",
        "evidence",
        "report_sha256"
      ],
      "properties": {
        "protocol_version": {
          "const": 2
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "protocol_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "frozen_corpus_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "classes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "handwriting",
            "print",
            "mixed_marks",
            "aged",
            "alpha",
            "color_text",
            "stains",
            "bleed_through",
            "skew",
            "oversharpened",
            "already_good",
            "faint_marks",
            "preservation_control"
          ],
          "properties": {
            "handwriting": {
              "$ref": "#/$defs/class_report"
            },
            "print": {
              "$ref": "#/$defs/class_report"
            },
            "mixed_marks": {
              "$ref": "#/$defs/class_report"
            },
            "aged": {
              "$ref": "#/$defs/class_report"
            },
            "alpha": {
              "$ref": "#/$defs/class_report"
            },
            "color_text": {
              "$ref": "#/$defs/class_report"
            },
            "stains": {
              "$ref": "#/$defs/class_report"
            },
            "bleed_through": {
              "$ref": "#/$defs/class_report"
            },
            "skew": {
              "$ref": "#/$defs/class_report"
            },
            "oversharpened": {
              "$ref": "#/$defs/class_report"
            },
            "already_good": {
              "$ref": "#/$defs/class_report"
            },
            "faint_marks": {
              "$ref": "#/$defs/class_report"
            },
            "preservation_control": {
              "$ref": "#/$defs/class_report"
            }
          }
        },
        "decision": {
          "enum": [
            "accepted",
            "abstain"
          ]
        },
        "clearance": {
          "type": "string",
          "minLength": 1
        },
        "build_commit_binding": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sample",
              "roles",
              "fidelity_errors",
              "prior_reviews",
              "reviews",
              "review_revisions",
              "frozen_policy"
            ],
            "properties": {
              "sample": {
                "type": "string",
                "minLength": 1
              },
              "roles": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "candidate",
                  "baseline",
                  "replicate"
                ],
                "properties": {
                  "candidate": {
                    "$ref": "#/$defs/role_report"
                  },
                  "baseline": {
                    "$ref": "#/$defs/role_report"
                  },
                  "replicate": {
                    "$ref": "#/$defs/role_report"
                  }
                }
              },
              "fidelity_errors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "prior_reviews": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/review_revision"
                }
              },
              "reviews": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/review"
                }
              },
              "review_revisions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reference"
                }
              },
              "frozen_policy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "commands",
                  "assets"
                ],
                "properties": {
                  "source": {
                    "$ref": "#/$defs/sample"
                  },
                  "commands": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "candidate",
                      "baseline",
                      "replicate"
                    ],
                    "properties": {
                      "candidate": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 6
                      },
                      "baseline": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 6
                      },
                      "replicate": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 6
                      }
                    }
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "sha256"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    },
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "bundle",
        "execution"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "completed",
            "refused",
            "failed",
            "missing_evidence"
          ]
        },
        "bundle": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "execution": {
          "oneOf": [
            {
              "$ref": "#/$defs/execution"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "missing_evidence"
              }
            }
          },
          "then": {
            "properties": {
              "bundle": {
                "type": "null"
              },
              "execution": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "execution": {
                "$ref": "#/$defs/execution"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "bundle": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "stdout",
        "stderr",
        "exit_code",
        "timed_out",
        "response",
        "publication"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 6
        },
        "stdout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "stderr": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -2147483648,
          "maximum": 4294967295
        },
        "timed_out": {
          "type": "boolean"
        },
        "response": {
          "type": [
            "object",
            "null"
          ]
        },
        "publication": {
          "enum": [
            "not_started",
            "not_published",
            "completed",
            "unknown"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "blind_pair",
        "delta",
        "harms",
        "uncertain",
        "rationale"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "blind_pair": {
          "type": "string",
          "minLength": 1
        },
        "delta": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2
        },
        "harms": {
          "type": "array",
          "items": {
            "enum": [
              "lost_mark",
              "clipped_glyph",
              "false_contour",
              "degraded_good_page",
              "geometry",
              "protection"
            ]
          },
          "minItems": 0
        },
        "uncertain": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample",
        "reviews"
      ],
      "properties": {
        "sample": {
          "type": "string",
          "minLength": 1
        },
        "reviews": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/review"
          }
        }
      }
    },
    "class_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "positive",
        "sign_tail",
        "harmed",
        "uncertain",
        "incomplete",
        "accepted",
        "pages",
        "engineering_failed",
        "engineering_refused",
        "missing_evidence",
        "review_incomplete"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "positive": {
          "type": "integer",
          "minimum": 0
        },
        "sign_tail": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "harmed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uncertain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "incomplete": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "accepted": {
          "type": "boolean"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sample",
              "engineering_complete",
              "review_complete",
              "harms",
              "uncertain",
              "delta",
              "outcomes",
              "natural_document"
            ],
            "properties": {
              "sample": {
                "type": "string",
                "minLength": 1
              },
              "engineering_complete": {
                "type": "boolean"
              },
              "review_complete": {
                "type": "boolean"
              },
              "harms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "uncertain": {
                "type": "boolean"
              },
              "delta": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "outcomes": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "candidate",
                  "baseline",
                  "replicate"
                ],
                "properties": {
                  "candidate": {
                    "enum": [
                      "completed",
                      "refused",
                      "failed",
                      "missing_evidence"
                    ]
                  },
                  "baseline": {
                    "enum": [
                      "completed",
                      "refused",
                      "failed",
                      "missing_evidence"
                    ]
                  },
                  "replicate": {
                    "enum": [
                      "completed",
                      "refused",
                      "failed",
                      "missing_evidence"
                    ]
                  }
                }
              },
              "natural_document": {
                "type": "boolean"
              }
            }
          }
        },
        "engineering_failed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "engineering_refused": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_incomplete": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "role_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "declared",
        "errors",
        "record_sha256",
        "replay_argv",
        "replay_attempt",
        "observed_publication"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "completed",
            "refused",
            "failed",
            "missing_evidence"
          ]
        },
        "declared": {
          "$ref": "#/$defs/role"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "record_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "replay_argv": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "replay_attempt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/replay_attempt"
            }
          ]
        },
        "observed_publication": {
          "enum": [
            "not_started",
            "not_published",
            "completed",
            "unknown"
          ]
