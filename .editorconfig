root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cpp,hpp,c,h,py}]
indent_size = 4
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[fuzz/{corpus,regressions}/**]
insert_final_newline = false
trim_trailing_whitespace = false
