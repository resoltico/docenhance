{
  "type": "object",
  "required": [
    "record",
    "build",
    "source",
    "request",
    "execution",
    "protection",
    "output"
  ],
  "additionalProperties": false,
  "properties": {
    "record": {
      "type": "object",
      "required": [
        "version",
        "run",
        "recorded"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 3
        },
        "run": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "recorded": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "application_version",
        "platform",
        "compiler",
        "dependency_lock_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "application_version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "dependency_lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "sha256",
        "bytes",
        "name",
        "decoding"
      ],
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000/]+$"
        },
        "decoding": {
          "$ref": "#/$defs/source_decoding"
        }
      }
    },
    "request": {
      "type": "object",
      "required": [
        "operation",
        "protection_supplied",
        "denoising"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "type": "object",
          "required": [
            "kind",
            "method",
            "parameters"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "binarization",
                "continuous"
              ]
            },
            "method": {},
            "parameters": {}
          },
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "continuous"
                },
                "method": {
                  "type": "null"
                },
                "parameters": {
                  "type": "object",
                  "required": [
                    "output_mode",
                    "depth",
                    "alpha",
                    "profile"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "output_mode": {
                      "enum": [
                        "gray",
                        "preserve"
                      ]
                    },
                    "depth": {
                      "enum": [
                        "automatic",
                        "8",
                        "16"
                      ]
                    },
                    "alpha": {
                      "enum": [
                        "black",
                        "white",
                        "reject"
                      ]
                    },
                    "profile": {
                      "enum": [
                        "embedded",
                        "srgb"
                      ]
                    }
                  }
                }
              }
            },
            {
              "properties": {
                "kind": {
                  "const": "binarization"
                },
                "method": {
                  "$ref": "#/$defs/binary_method"
                },
                "parameters": {}
              },
              "oneOf": [
                {
                  "properties": {
                    "method": {
                      "properties": {
                        "id": {
                          "const": "B02"
                        }
                      }
                    },
                    "parameters": {
                      "type": "object",
                      "required": [
                        "window",
                        "k",
                        "r"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "window": {
                          "type": "integer",
                          "minimum": 3,
                          "maximum": 4095,
                          "not": {
                            "multipleOf": 2
                          }
                        },
                        "k": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "r": {
                          "type": "number",
                          "minimum": 0.00392156862745098,
                          "maximum": 1
                        }
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "method": {
                      "properties": {
                        "id": {
                          "const": "B03"
                        }
                      }
                    },
                    "parameters": {
                      "type": "object",
                      "required": [
                        "threshold"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "threshold": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "protection_supplied": {
          "type": "boolean"
        },
        "denoising": {
          "$ref": "#/$defs/denoising_request"
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "conversion",
        "illumination",
        "denoising"
      ],
      "additionalProperties": false,
      "properties": {
        "conversion": {
          "anyOf": [
            {
              "$ref": "#/$defs/conversion"
            },
            {
              "type": "null"
            }
          ]
        },
        "illumination": {
          "$ref": "#/$defs/illumination"
        },
        "denoising": {
          "$ref": "#/$defs/denoising"
        }
      }
    },
    "protection": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "supplied",
            "stored",
            "width",
            "height",
            "polarity",
            "frame"
          ],
          "additionalProperties": false,
          "properties": {
            "supplied": {
              "type": "object",
              "required": [
                "sha256",
                "bytes"
              ],
              "additionalProperties": false,
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 18446744073709551615
                }
              }
            },
            "stored": {
              "type": "object",
              "required": [
                "path",
                "sha256",
                "bytes"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "const": "assets/protect-mask.png"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 268435456
                }
              }
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "polarity": {
              "const": "white_protects"
            },
            "frame": {
              "const": "oriented_source"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "output": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes",
        "width",
        "height",
        "channels",
        "bit_depth",
        "profile_embedded",
        "resolution",
        "verification"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "result.png"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "channels": {
          "enum": [
            1,
            3
          ]
        },
        "bit_depth": {
          "enum": [
            8,
            16
          ]
        },
        "profile_embedded": {
          "type": "boolean"
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        },
        "verification": {
          "type": "object",
          "required": [
            "performed",
            "compared"
          ],
          "additionalProperties": false,
          "properties": {
            "performed": {
              "const": "decoded_and_compared"
            },
            "compared": {
              "const": [
                "integer_samples",
                "metadata"
              ]
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docenhance.invalid/schemas/run-record.schema.json",
  "$defs": {
    "binary_method": {
      "type": "object",
      "required": [
        "id",
        "method_version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "method_version": {
          "type": "integer"
        }
      },
      "oneOf": [
        {
          "properties": {
            "id": {
              "const": "B02"
            },
            "method_version": {
              "const": 1
            }
          }
        },
        {
          "properties": {
            "id": {
              "const": "B03"
            },
            "method_version": {
              "const": 1
            }
          }
        }
      ]
    },
    "conversion": {
      "type": "object",
      "required": [
        "decoded_input",
        "encoded_output",
        "profile_decision",
        "assumed_transfer",
        "assumed_primaries",
        "source_orientation",
        "resolution",
        "alpha_flattened_pixels",
        "clipped_components",
        "depth_reduced",
        "verified",
        "warnings"
      ],
      "additionalProperties": false,
      "properties": {
        "decoded_input": {
          "type": "object",
          "required": [
            "width",
            "height",
            "channels",
            "bit_depth"
          ],
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "channels": {
              "enum": [
                1,
                2,
                3,
                4
              ]
            },
            "bit_depth": {
              "enum": [
                8,
                16
              ]
            }
          },
          "description": "Decoded integer source samples before interpretation. Known sRGB/gamma and alpha use double scalar calculations; ICC/chromaticity interpretation retains the bounded native color engine precision."
        },
        "encoded_output": {
          "type": "object",
          "required": [
            "width",
            "height",
            "channels",
            "bit_depth"
          ],
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "channels": {
              "enum": [
                1,
                3
              ]
            },
            "bit_depth": {
              "enum": [
                8,
                16
              ]
            }
          }
        },
        "profile_decision": {
          "enum": [
            "assumed_srgb",
            "overridden_srgb",
            "srgb",
            "cicp_srgb",
            "icc",
            "png_gamma",
            "png_chromaticities"
          ]
        },
        "assumed_transfer": {
          "type": "boolean"
        },
        "assumed_primaries": {
          "type": "boolean"
        },
        "source_orientation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "resolution": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "x_ppm",
                "y_ppm"
              ],
              "additionalProperties": false,
              "properties": {
                "x_ppm": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                },
                "y_ppm": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                }
              }
            }
          ]
        },
        "alpha_flattened_pixels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "clipped_components": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "depth_reduced": {
          "type": "boolean"
        },
        "verified": {
          "const": true
        },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 4,
          "items": {
            "enum": [
              "W_PROFILE_ASSUMED",
              "W_PROFILE_OVERRIDDEN",
              "W_ALPHA_FLATTENED",
              "W_DEPTH_REDUCED"
            ]
          }
        }
      }
    },
    "resolution": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "x_ppm",
            "y_ppm"
          ],
          "additionalProperties": false,
          "properties": {
            "x_ppm": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "y_ppm": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          }
        }
      ]
    },
    "illumination": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "method",
        "requested",
        "resolved_cell",
        "eligible_samples",
        "protected_samples",
        "cells",
        "measured_cells",
        "dark_cells",
        "background_reference",
        "coverage",
        "solver",
        "measurements",
        "auto_predicates",
        "application",
        "complete"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "disabled",
            "no_change",
            "skipped",
            "applied",
            "failed"
          ]
        },
        "reason": {
          "enum": [
            "none",
            "zero_strength",
            "unit_gain",
            "no_eligible_samples",
            "insufficient_samples",
            "insufficient_cells",
            "automatic_predicates",
            "no_effect",
            "processing_failure"
          ]
        },
        "method": {
          "anyOf": [
            {
              "$ref": "#/$defs/illumination_method"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "mode",
                "strength",
                "max_gain",
                "target",
                "cell",
                "quantile",
                "smooth"
              ],
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "surface",
                    "auto"
                  ]
                },
                "strength": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "max_gain": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 4
                },
                "target": {
                  "anyOf": [
                    {
                      "const": "source"
                    },
                    {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 1
                    }
                  ]
                },
                "cell": {
                  "anyOf": [
                    {
                      "const": "auto"
                    },
                    {
                      "type": "integer",
                      "minimum": 8,
                      "maximum": 512
                    }
                  ]
                },
                "quantile": {
                  "type": "number",
                  "minimum": 0.75,
                  "maximum": 0.99
                },
                "smooth": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 20
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "resolved_cell": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 8,
              "maximum": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "eligible_samples": {
          "type": "integer",
          "minimum": 0
        },
        "protected_samples": {
          "type": "integer",
          "minimum": 0
        },
        "cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "measured_cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "dark_cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "background_reference": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "solver": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "iterations",
                "residual",
                "tolerance"
              ],
              "additionalProperties": false,
              "properties": {
                "iterations": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 500
                },
                "residual": {
                  "type": "number",
                  "minimum": 0
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "measurements": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "stride",
                "count",
                "fallback",
                "target",
                "background_q10",
                "background_q50",
                "background_q90",
                "luminance_q90",
                "variation",
                "paper_fraction",
                "dark_fraction"
              ],
              "additionalProperties": false,
              "properties": {
                "stride": {
                  "type": "integer",
                  "minimum": 1
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1048576
                },
                "fallback": {
                  "type": "boolean"
                },
                "target": {
                  "type": "number",
                  "minimum": 0
                },
                "background_q10": {
                  "type": "number",
                  "minimum": 0
                },
                "background_q50": {
                  "type": "number",
                  "minimum": 0
                },
                "background_q90": {
                  "type": "number",
                  "minimum": 0
                },
                "luminance_q90": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "variation": {
                  "type": "number",
                  "minimum": 0
                },
                "paper_fraction": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "dark_fraction": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "auto_predicates": {
          "type": "object",
          "required": [
            "coverage",
            "bright_quantile",
            "median_background",
            "background_variation",
            "paper_fraction",
            "dark_fraction"
          ],
          "additionalProperties": false,
          "properties": {
            "coverage": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "bright_quantile": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "median_background": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "background_variation": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "paper_fraction": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dark_fraction": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "application": {
          "type": "object",
          "required": [
            "evaluated_samples",
            "changed_samples",
            "gain_capped_samples",
            "saturated_samples",
            "min_gain",
            "max_gain",
            "gain_capped_fraction",
            "saturated_fraction"
          ],
          "additionalProperties": false,
          "properties": {
            "evaluated_samples": {
              "type": "integer",
              "minimum": 0
            },
            "changed_samples": {
              "type": "integer",
              "minimum": 0
            },
            "gain_capped_samples": {
              "type": "integer",
              "minimum": 0
            },
            "saturated_samples": {
              "type": "integer",
              "minimum": 0
            },
            "min_gain": {
              "type": "number",
              "minimum": 1,
              "maximum": 4
            },
            "max_gain": {
              "type": "number",
              "minimum": 1,
              "maximum": 4
            },
            "gain_capped_fraction": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "saturated_fraction": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "complete": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "disabled"
              }
            }
          },
          "then": {
            "properties": {
              "method": {
                "type": "null"
              },
              "requested": {
                "type": "null"
              },
              "reason": {
                "const": "none"
              }
            }
          },
          "else": {
            "properties": {
              "method": {
                "$ref": "#/$defs/illumination_method"
              },
              "requested": {
                "type": "object",
                "required": [
                  "mode",
                  "strength",
                  "max_gain",
                  "target",
                  "cell",
                  "quantile",
                  "smooth"
                ],
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "enum": [
                      "surface",
                      "auto"
                    ]
                  },
                  "strength": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "max_gain": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "target": {
                    "anyOf": [
                      {
                        "const": "source"
                      },
                      {
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 1
